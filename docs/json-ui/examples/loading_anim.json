{
  "namespace": "loading_anim",

  "//_1_registro": "ui/center/hud/loading_anim.json — NEW file (no override), registered in _ui_defs.json.",
  "//_2_ciclo": "Alpha in -> wait -> alpha out sequence. 'next' chains animations without JS.",
  "subtitle_fade_in": {
    "anim_type": "alpha",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": 0,
    "to": 1
  },
  "subtitle_fade_out": {
    "anim_type": "alpha",
    "easing": "in_cubic",
    "duration": 0.5,
    "from": 1,
    "to": 0,
    "next": "@loading_anim.subtitle_fade_in"
  },

  "//_3_barra_de_carga": "Bar = fixed background image + filler whose SIZE grows (anim_type size) from 0 to 200px. Easing in_out_circ.",
  "anim_loading_bar": {
    "anim_type": "size",
    "easing": "in_out_circ",
    "duration": "$loading_bar_duration",
    "from": [0, 16],
    "to": [200, 16]
  },
  "loading_bar_background": {
    "type": "image",
    "texture": "textures/ui/loading_anim/loading_bar_background",
    "size": [200, 16],
    "controls": [
      {
        "loading_bar": {
          "type": "image",
          "texture": "textures/ui/loading_anim/loading_bar_filler",
          "size": [200, 16],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "anims": ["@loading_anim.anim_loading_bar"]
        }
      }
    ]
  },

  "//_4_flip_book": "Sprite sheet animation: advances the UV over a frame texture. The control's 'uv' = the animation.",
  "pick_axe_animation": {
    "anim_type": "flip_book",
    "initial_uv": [0, 0],
    "frame_count": 91,
    "frame_step": 10,
    "fps": 30,
    "reversible": false,
    "easing": "linear"
  },
  "pickaxe": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ui/loading_anim/mine_chop_dig_animation",
    "size": [30, 30],
    "uv_size": [10, 10],
    "uv": "@loading_anim.pick_axe_animation",
    "color": [1, 1, 1, 1]
  }
}