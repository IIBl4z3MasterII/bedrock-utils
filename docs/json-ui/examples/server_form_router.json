{
  "namespace": "server_form",

  "//_1_pantalla_base": "Override of the vanilla third_party_server_screen screen. Registered in ui/server_form.json and NOT in _ui_defs.json (same-key override).",
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },

  "//_2_router_por_factory": "A factory node decides which form to render based on the type sent by the BP (native long_form, or custom_form = search_form).",
  "main_screen_content": {
    "type": "panel",
    "size": ["90%", "80%"],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_long_form"
          }
        }
      }
    ]
  },

  "//_3_dentro_de_long_form": "The vanilla long_form only shows if the title does NOT have the marker prefix. If the BP sends a title with '§b§l§4§z§3', the custom search form mounts (with search box + filterable grid).",
  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "simple_long_form": {
          "type": "panel",
          "size": ["100%", "100%"],
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§b§l§4§z§3') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "custom_long_form@search_form.advanced_long_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§b§l§4§z§3') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}