{
  "namespace": "scoreboard",

  "//_1_override": "ui/scoreboards.json — same-key override of the vanilla. NOT registered in _ui_defs.json.",
  "scoreboard_sidebar": {
    "type": "panel",
    "size": ["100%cm", "100%c"],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "bindings": [
      {
        "binding_name": "#scoreboard_sidebar_visible",
        "binding_type": "global",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "main": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.5,
          "size": ["100%cm", "100%c"],
          "controls": [
            {
              "displayed_objective": {
                "type": "label",
                "size": ["default", 10],
                "text": "#objective_sidebar_name",
                "text_alignment": "center",
                "inherit_max_sibling_width": true,
                "color": "$objective_title_color",
                "bindings": [{ "binding_name": "#objective_sidebar_name", "binding_type": "global" }]
              }
            },
            {
              "lists": {
                "type": "panel",
                "size": ["100%c", "100%cm"],
                "offset": [0, 10],
                "controls": [
                  {
                    "players": {
                      "type": "stack_panel",
                      "orientation": "vertical",
                      "size": ["100%cm", "100%c"],
                      "collection_name": "scoreboard_players",
                      "factory": {
                        "name": "player_list_factory",
                        "control_name": "scoreboard.scoreboard_sidebar_player"
                      },
                      "bindings": [{
                        "binding_name": "#scoreboard_sidebar_size",
                        "binding_type": "global",
                        "binding_name_override": "#collection_length"
                      }]
                    }
                  },
                  {
                    "scores": {
                      "type": "stack_panel",
                      "orientation": "vertical",
                      "size": ["100%cm", "100%c"],
                      "collection_name": "scoreboard_scores",
                      "factory": {
                        "name": "player_score_factory",
                        "control_name": "scoreboard.scoreboard_sidebar_score"
                      },
                      "bindings": [{
                        "binding_name": "#scoreboard_sidebar_size",
                        "binding_type": "global",
                        "binding_name_override": "#collection_length"
                      }]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "//_2_fila_jugador": "The factory instantiates this template per player. The scoreboard_players / scoreboard_scores collections are filled from the BP (native scoreboard bindings).",
  "scoreboard_sidebar_player": {
    "type": "label",
    "layer": 2,
    "text": "#player_name_sidebar",
    "text_alignment": "left",
    "size": ["default", 10],
    "inherit_max_sibling_width": true,
    "color": "$player_name_color",
    "bindings": [{
      "binding_name": "#player_name_sidebar",
      "binding_type": "collection",
      "binding_collection_name": "scoreboard_players"
    }]
  },

  "scoreboard_sidebar_score": {
    "type": "label",
    "layer": 2,
    "size": ["default", 10],
    "text": "#player_score_sidebar",
    "text_alignment": "right",
    "inherit_max_sibling_width": true,
    "color": "$player_score_color",
    "bindings": [{
      "binding_name": "#player_score_sidebar",
      "binding_type": "collection",
      "binding_collection_name": "scoreboard_scores"
    }]
  }
}